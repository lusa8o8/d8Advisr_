{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@11.17.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const fs=require('node:fs'); for (const f of ['package-lock.json','yarn.lock']) fs.rmSync(f,{force:true}); if (!(process.env.npm_config_user_agent||'').startsWith('pnpm/')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "dev:consumer": "pnpm --filter @workspace/d8advisr run dev",
    "dev:partner": "pnpm --filter @workspace/d8advisr-partner run dev",
    "dev:consumer:staging": "pnpm --filter @workspace/d8advisr exec vite --config vite.config.ts --host 0.0.0.0 --mode staging",
    "dev:partner:staging": "pnpm --filter @workspace/d8advisr-partner exec vite --config vite.config.ts --host 0.0.0.0 --mode staging",
    "test:local:browser-env": "node scripts/check-local-browser-env.mjs",
    "test:session-lifecycle:static": "node scripts/check-session-lifecycle.mjs",
    "build:staging": "pnpm --filter @workspace/d8advisr exec vite build --config vite.config.ts --mode staging && pnpm --filter @workspace/d8advisr-partner exec vite build --config vite.config.ts --mode staging",
    "test:staging": "node scripts/staging-smoke.mjs",
    "test:staging:full": "node scripts/staging-smoke.mjs --require-identities",
    "test:phase3:static": "node scripts/check-phase3-migration.mjs",
    "test:staging:phase3": "node scripts/staging-phase3-smoke.mjs",
    "test:phase4:static": "node scripts/check-phase4-migration.mjs",
    "test:phase4:draft-edit:static": "node scripts/check-phase4-draft-edit-migration.mjs",
    "test:phase4:live-revision:static": "node scripts/check-phase4-live-revision-migration.mjs",
    "test:staging:phase4": "node scripts/staging-phase4-smoke.mjs",
    "test:staging:phase4:draft-edit": "node scripts/staging-phase4-draft-edit-smoke.mjs",
    "test:staging:phase4:live-revision": "node scripts/staging-phase4-live-revision-smoke.mjs",
    "test:phase45:reference:static": "node scripts/check-phase45-reference-catalogs.mjs",
    "test:partner-venue-parity:static": "node scripts/check-partner-venue-parity-migration.mjs",
    "test:phase45:browser-closure:static": "node scripts/check-phase45-browser-closure.mjs",
    "test:staging:phase45:reference": "node scripts/staging-phase45-reference-smoke.mjs",
    "test:staging:phase45:media": "node scripts/staging-phase45-media-smoke.mjs",
    "test:staging:phase45:partner-revision": "node scripts/staging-phase45-partner-revision-smoke.mjs",
    "test:staging:phase45": "pnpm run test:phase45:reference:static && pnpm run test:partner-venue-parity:static && pnpm run test:staging:phase45:reference && pnpm run test:staging:phase45:media && pnpm run test:staging:phase45:partner-revision",
    "staging:identities:create": "node scripts/staging-create-identities.mjs --confirm-staging",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
