VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Optional. Set this to the consumer app's public origin in production/mobile
# testing so OAuth does not redirect back to localhost.
VITE_AUTH_REDIRECT_ORIGIN=
# Required in production. Example: https://partner.d8advisr.com
VITE_PARTNER_ORIGIN=http://localhost:3001
DEV_ALLOWED_HOSTS=localhost,127.0.0.1

# Only needed if the Express API artifact is deployed.
ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app,https://your-production-domain.com
